{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-verification-index.schema.json",
  "title": "Rootless local final verification index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "plan_binding_sha256",
    "execution_commit",
    "outcome",
    "publication_receipt_sha256",
    "zero_call_skip_sha256",
    "state_inventory_sha256",
    "ordered_pre_egress_evidence",
    "ordered_final_evidence",
    "legacy_input_manifest_sha256",
    "provider_calls_before",
    "provider_calls_after",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "rootless_final_verification_index_v1"},
    "profile": {"const": "local_rootless_non_authoritative"},
    "plan_binding_sha256": {"$ref": "#/$defs/nullableHash"},
    "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["paid_attempt", "zero_call_skip"]},
    "publication_receipt_sha256": {"$ref": "#/$defs/nullableHash"},
    "zero_call_skip_sha256": {"$ref": "#/$defs/nullableHash"},
    "state_inventory_sha256": {"$ref": "#/$defs/nullableHash"},
    "ordered_pre_egress_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "ordered_final_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "legacy_input_manifest_sha256": {"$ref": "#/$defs/hash"},
    "provider_calls_before": {"type": "integer", "minimum": 0},
    "provider_calls_after": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "repo_relative_path", "size_bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "repo_relative_path": {"type": "string", "minLength": 1, "maxLength": 256},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
